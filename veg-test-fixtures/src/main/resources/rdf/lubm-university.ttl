@prefix rdf:  <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix owl:  <http://www.w3.org/2002/07/owl#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .
@prefix lubm: <http://swat.cse.lehigh.edu/onto/univ-bench.owl#> .
@prefix data: <http://www.Department0.University0.edu/> .

# --- LUBM Ontology Core Classes & Semantic Predicate Rules ---
lubm:University  a rdfs:Class .
lubm:Department  a rdfs:Class .
lubm:Professor   a rdfs:Class .
lubm:Course      a rdfs:Class .
lubm:Student     a rdfs:Class .
lubm:Publication a rdfs:Class .

lubm:memberOf              a rdf:Property .
lubm:worksFor              a rdf:Property ; rdfs:subPropertyOf lubm:memberOf .
lubm:headOf                a rdf:Property ; rdfs:subPropertyOf lubm:worksFor .
lubm:chairOf               a rdf:Property ; rdfs:subPropertyOf lubm:headOf .
lubm:affiliatedDepartment  a rdf:Property .
lubm:subOrganizationOf     a rdf:Property .

lubm:degreeFrom  a rdf:Property .
lubm:hasAlumnus  a rdf:Property ; owl:inverseOf lubm:degreeFrom .

lubm:hasAdvisor  a rdf:Property .
lubm:advisorOf   a rdf:Property ; owl:inverseOf lubm:hasAdvisor .

lubm:teachesCourse     a rdf:Property .
lubm:takesCourse       a rdf:Property .
lubm:publicationAuthor a rdf:Property .

# --- Universities (2) ---
data:University0 a lubm:University ;
    lubm:name "Lehigh University" ;
    lubm:country "US" .

data:University1 a lubm:University ;
    lubm:name "TU Graph Research" ;
    lubm:country "DE" .

# --- Departments (4) ---
data:DeptCS0 a lubm:Department ;
    lubm:name "Computer Science Dept 0" ;
    lubm:subOrganizationOf data:University0 .

data:DeptEE0 a lubm:Department ;
    lubm:name "Electrical Engineering Dept 0" ;
    lubm:subOrganizationOf data:University0 .

data:DeptCS1 a lubm:Department ;
    lubm:name "Informatics Dept 1" ;
    lubm:subOrganizationOf data:University1 .

data:DeptMath1 a lubm:Department ;
    lubm:name "Applied Mathematics Dept 1" ;
    lubm:subOrganizationOf data:University1 .

